Checks: >
  bugprone-*,
  modernize-*,
  performance-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -readability-uppercase-literal-suffix,
  -readability-identifier-length,
  -modernize-use-nodiscard

WarningsAsErrors: ""
HeaderFilterRegex: '.*/firmware/(src|include)/.*'
ExcludeHeaderFilterRegex: '.*/(\.pio|\.platformio)/.*'
SystemHeaders: false
FormatStyle: file
